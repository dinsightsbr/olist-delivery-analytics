              {
                "textRuns": [
                  {
                    "value": "How to read this page",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "bold",
                      "color": "#1A202C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Only 3 in 100 customers ever place a second order, so the business lives on first impressions. The three cards on the right split customers by what happened on their first order: delivered on time, delivered late, or rated 1-2 stars. If the repeat rate after a late first order is clearly lower, late deliveries are not only a review problem but a retention problem, and the carrier work on page 3 has a revenue case.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1A202C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Repeat status comes from the whole dataset (a customer may have returned after Aug 2018 is not visible), so the rates are conservative. Cohorts list customers by the month of their first purchase.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#718096"
                    }
                  }
                ]
              }
            ]
          }
        }
