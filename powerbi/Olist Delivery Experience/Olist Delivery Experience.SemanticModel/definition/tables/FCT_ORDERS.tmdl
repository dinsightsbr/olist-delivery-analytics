	column 'Is First Order' = FCT_ORDERS[purchased_at] = CALCULATE ( MIN ( FCT_ORDERS[purchased_at] ), ALLEXCEPT ( FCT_ORDERS, FCT_ORDERS[customer_unique_id] ) )
		dataType: boolean
		isDataTypeInferred
		lineageTag: 06a21342-3a13-5b7d-9e04-f7559e2160be
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Seller Handling Days' = IF ( ISBLANK ( FCT_ORDERS[approved_at] ) || ISBLANK ( FCT_ORDERS[delivered_to_carrier_at] ), BLANK (), DATEDIFF ( FCT_ORDERS[approved_at], FCT_ORDERS[delivered_to_carrier_at], DAY ) )
		dataType: int64
		formatString: 0
		isDataTypeInferred
		lineageTag: 1b53165f-f9d1-5660-8b19-0d4d6ec3aeeb
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Carrier Transit Days' = IF ( ISBLANK ( FCT_ORDERS[delivered_to_carrier_at] ) || ISBLANK ( FCT_ORDERS[delivered_to_customer_at] ), BLANK (), DATEDIFF ( FCT_ORDERS[delivered_to_carrier_at], FCT_ORDERS[delivered_to_customer_at], DAY ) )
		dataType: int64
		formatString: 0
		isDataTypeInferred
		lineageTag: 716358e9-6c1d-5f1c-b745-baf619f2e539
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Cart Size' = SWITCH ( TRUE (), ISBLANK ( FCT_ORDERS[Items in Order] ), "No items", FCT_ORDERS[Items in Order] = 1, "1 item", FCT_ORDERS[Items in Order] = 2, "2 items", "3+ items" )
		dataType: string
		isDataTypeInferred
		lineageTag: d50e3775-aac1-5f26-a077-5701ef7f4088
		summarizeBy: none

		annotation SummarizationSetBy = User

